# Supplied by the Vercel Neon integration. Never commit the real value.
DATABASE_URL=postgresql://user:password@example.neon.tech/database?sslmode=require

# Self-hosted Better Auth. Keep the secret server-only and use a unique random
# value of at least 32 characters. The URL must be the canonical deployment URL.
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=https://your-production-domain.example
CLINICIAN_ADMIN_EMAILS=authorized-clinician@example.com
